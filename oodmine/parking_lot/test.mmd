classDiagram
    class Vehicle {
        <<interface>>
        +getLicensePlate() string
        + getVehicleSize() string
    }
    class VehicleSize {
        <<enumeration>>
        SMALL,
        MEDIUM,
        LARGE
    }
    class MotorCycle {
        + String LicensePlate,

    }
    class Car {
        string LicensePlate
    }
    class Truck {
        string licensePlate
    }
    Vehicle <|.. Car
    Vehicle <|.. MotorCycle
    Vehicle <|.. Truck

    class ParkingSpot {
        <<interface>>
        boolean isAvailable()
        void occupy(Vehicle vehicle)
        void vacate()
        VehicleSize getVehicleSize()
    }
    class CompactSpot {
        int spotNumber
        Vehicle vehicle
    }
    class MediumSpot {
        int spotNumber
        Vehicle vehicle
    }
    class LargeSpot {
        int spotNumber
        Vehicle vehicle
    }
    ParkingSpot <|.. CompactSpot
    ParkingSpot <|.. MediumSpot
    ParkingSpot <|.. LargeSpot

class ParkingManager {
    Map<VehicleSize, List<ParkingSpot>> availableSpots
    Map<Vehicle, ParkingSpot> vehicleToSpotMap
    ParkingSpot findAvailableSpot(Vehicle vehicle)
    parkingSpot parkVehicle(Vehicle vehicle)
    void unparkVehicle(Vehicle vehicle)
}
class Ticket {
    String TicketId %%readOnly
    Vehicle vehicle %%readOnly
    ParkingSpot parkingSpot %%readOnly
    LocalDateTime entryTime %%readOnly
    LocalDateTime exitTime
    BigDecimal calculateParkingDuration()
}

class FareCalculator {
    List<FareStrategy> fareStrategies
    BigDecimal calculateFare(Ticket ticket)
}

class FareStrategy {
    <<interface>>
    BigDecimal calculateFare(Ticket ticket, BigDecimal inputFare)
}

class BaseFareStrategy {
    BigDecimal SMALL_VEHICLE_RATE
    BigDecimal MEDIUM_VEHICLE_RATE
    BigDecimal LARGE_VEHICLE_RATE
    BigDecimal calculateFare(Ticket ticket, BigDecimal inputFare)
}

class PeakHoursStrategy {
    BigDecimal PEAK_HOURS_MULTIPLIER
    BigDecimal calculateFare(Ticket ticket, BigDecimal inputFare) 
}
FareStrategy <|.. BaseFareStrategy
FareStrategy <|.. PeakHoursStrategy
FareCalculator *-- FareStrategy



class ParkingLot {
    BigDecimal calculateFare()
    Vehicle enterlot()
    Void leaveinglot()

}
